	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Xcode 27 / iOS 18+ SDK requiere el ciclo de vida por escenas.
	     SDL2 (uikit) no es scene-based por defecto; usamos un scene delegate
	     propio (SDLUIKitSceneDelegate) que puentea al SDLUIKitDelegate. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>SDLScene</string>
					<key>UISceneDelegateClassName</key>
					<string>SDLUIKitSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
