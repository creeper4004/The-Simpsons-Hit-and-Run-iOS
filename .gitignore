# Android Studio / Gradle / CMake generated files
.gradle/
**/.gradle/

build/
**/build/

.cxx/
**/.cxx/

.externalNativeBuild/
**/.externalNativeBuild/

# Native/CMake/Ninja generated files
**/CMakeFiles/
**/.ninja_deps
**/.ninja_log
**/build.ninja
**/cmake_install.cmake
**/CMakeCache.txt

# Local Android config
local.properties

# IDE
.idea/
.vscode/
*.iml

# APKs and release files
APKs/
*.apk
*.aab

# Signing keys
*.jks
*.keystore
*.pem
*.p12

# iOS build artifacts (CMake -G Xcode generates a sibling build dir)
build_ios/
**/build_ios/

# iOS FFmpeg static libs (built outside the repo via ios-project/build-ffmpeg.sh; do NOT commit)
ios-project/external/ffmpeg/
ios-project/external/

# Xcode DerivedData / user data
xcuserdata/
*.xcuserstate

# Logs and temporary files
*.log
*.tmp
*.bak


# OS files
.DS_Store
Thumbs.db

# iOS game-asset bundle source (large, user-supplied PC assets)
game_assets/
iosbuild/.gitignore

# Local iOS CMake/Xcode build trees
/build_ios-*/
/build_ios_*/

# MGL upstream working checkout and its generated build outputs (recreated by iosbuild/build.sh)
/mgl-ios/src/
/mgl-ios/work/
