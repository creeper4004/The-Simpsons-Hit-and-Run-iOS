+// Upload the engine's ordinary RGBA8 2D textures through a staging buffer.
+// The destination texture uses private storage, so CPU replaceRegion uploads
+// are invalid here; the blit command buffer copies the CPU bytes into it.
+- (bool) uploadRGBA8Texture:(Texture *)tex toMetalTexture:(id<MTLTexture>)texture
+{
+    for (GLuint level = 0; level < tex->num_levels; ++level) {
+        TextureLevel *src = &tex->faces[0].levels[level];
+        if (!src->data || src->width == 0 || src->height == 0 || src->width != (texture.width >> level) || src->height != (texture.height >> level)) {
+            NSLog(@"MGL ERROR: Invalid RGBA8 source for texture %u level %u", tex->name, level);
+            return false;
+        }
+        if ((NSUInteger)src->width > NSUIntegerMax / 4) return false;
+
+        NSUInteger rowBytes = (NSUInteger)src->width * 4;
+        if (src->pitch < rowBytes || src->pitch > SIZE_MAX / src->height ||
+            src->data_size < src->pitch * (src->height - 1) + rowBytes ||
+            rowBytes > NSUIntegerMax - 255) {
+            NSLog(@"MGL ERROR: Invalid RGBA8 row layout for texture %u level %u (pitch=%lu size=%lu)",
+                  tex->name, level, (unsigned long)src->pitch, (unsigned long)src->data_size);
+            return false;
+        }
+
+        // Metal buffer-to-texture blits require suitably aligned source rows.
+        NSUInteger sourceBytesPerRow = (rowBytes + 255) & ~(NSUInteger)255;
+        if (sourceBytesPerRow > NSUIntegerMax / src->height) return false;
+        NSUInteger sourceBytesPerImage = sourceBytesPerRow * src->height;
+        uint8_t *stagingBytes = (uint8_t *)calloc(sourceBytesPerImage, 1);
+        if (!stagingBytes) return false;
+
+        const uint8_t *sourceBytes = (const uint8_t *)(uintptr_t)src->data;
+        for (GLuint y = 0; y < src->height; ++y) {
+            memcpy(stagingBytes + (NSUInteger)y * sourceBytesPerRow,
+                   sourceBytes + (size_t)y * src->pitch, rowBytes);
+        }
+
+        id<MTLBuffer> stagingBuffer = [_device newBufferWithBytes:stagingBytes
+                                                           length:sourceBytesPerImage
+                                                          options:MTLResourceStorageModeShared];
+        free(stagingBytes);
+        if (!stagingBuffer) return false;
+
+        id<MTLCommandBuffer> uploadCommandBuffer = [_commandQueue commandBuffer];
+        id<MTLBlitCommandEncoder> blitEncoder = [uploadCommandBuffer blitCommandEncoder];
+        if (!uploadCommandBuffer || !blitEncoder) {
+            NSLog(@"MGL ERROR: Could not create texture upload blit for texture %u level %u", tex->name, level);
+            return false;
+        }
+        [blitEncoder copyFromBuffer:stagingBuffer
+                       sourceOffset:0
+                   sourceBytesPerRow:sourceBytesPerRow
+                 sourceBytesPerImage:sourceBytesPerImage
+                          sourceSize:MTLSizeMake(src->width, src->height, 1)
+                           toTexture:texture
+                    destinationSlice:0
+                    destinationLevel:level
+                   destinationOrigin:MTLOriginMake(0, 0, 0)
+                             options:MTLBlitOptionNone];
+        [blitEncoder endEncoding];
+        [uploadCommandBuffer commit];
+        [uploadCommandBuffer waitUntilCompleted];
+        if (uploadCommandBuffer.status != MTLCommandBufferStatusCompleted) {
+            NSLog(@"MGL ERROR: Texture upload blit failed for texture %u level %u: %@",
+                  tex->name, level, uploadCommandBuffer.error);
+            return false;
+        }
+    }
+    return true;
+}
