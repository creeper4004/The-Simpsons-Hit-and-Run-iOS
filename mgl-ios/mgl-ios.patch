+// Plain standalone uniforms use native MSL layout, not std140 decorations.
+// In particular a float3 occupies 16 bytes and struct members are aligned.
+static size_t uniformAlign(size_t value, size_t alignment)
+{
+    return (value + alignment - 1) / alignment * alignment;
+}
+
+static size_t uniformTypeLayout(spvc_compiler compiler, spvc_type_id id, size_t *alignment)
+{
+    spvc_type type = spvc_compiler_get_type_handle(compiler, id);
+    size_t size = 0;
+    *alignment = 1;
+    if (spvc_type_get_basetype(type) == SPVC_BASETYPE_STRUCT) {
+        for (unsigned i = 0; i < spvc_type_get_num_member_types(type); ++i) {
+            size_t memberAlignment;
+            size_t memberSize = uniformTypeLayout(compiler, spvc_type_get_member_type(type, i), &memberAlignment);
+            size = uniformAlign(size, memberAlignment) + memberSize;
+            if (memberAlignment > *alignment) *alignment = memberAlignment;
+        }
+        size = uniformAlign(size, *alignment);
+    } else {
+        size_t scalarSize = spvc_type_get_bit_width(type) / 8;
+        if (!scalarSize) scalarSize = 4;
+        unsigned vectorSize = spvc_type_get_vector_size(type);
+        if (!vectorSize) vectorSize = 1;
+        *alignment = scalarSize * (vectorSize == 3 ? 4 : vectorSize);
+        size = *alignment * spvc_type_get_columns(type);
+    }
+    for (unsigned i = 0; i < spvc_type_get_num_array_dimensions(type); ++i)
+        size *= spvc_type_get_array_dimension(type, i);
+    return size;
+}
+
+static GLint addProgramUniform(Program *program, const char *name, GLint root,
+                               size_t offset, size_t size, bool sampler)
+{
+    for (GLuint i = 0; i < program->uniform_count; ++i)
+        if (!strcmp(program->uniforms[i].name, name)) return (GLint)i;
+    if (program->uniform_count == MAX_PROGRAM_UNIFORMS) return -1;
+    GLint location = (GLint)program->uniform_count++;
+    ProgramUniform *uniform = &program->uniforms[location];
+    uniform->name = strdup(name);
+    uniform->root = root < 0 ? location : root;
+    uniform->offset = offset;
+    uniform->size = size;
+    uniform->sampler = sampler;
+    return location;
+}
+
+static bool addUniformMembers(spvc_compiler compiler, Program *program,
+                              spvc_type_id id, const char *name, GLint root, size_t baseOffset)
+{
+    spvc_type type = spvc_compiler_get_type_handle(compiler, id);
+    size_t offset = 0;
+    for (unsigned i = 0; i < spvc_type_get_num_member_types(type); ++i) {
+        spvc_type_id memberType = spvc_type_get_member_type(type, i);
+        size_t alignment;
+        size_t size = uniformTypeLayout(compiler, memberType, &alignment);
+        offset = uniformAlign(offset, alignment);
+        char memberName[512];
+        snprintf(memberName, sizeof(memberName), "%s.%s", name,
+                 spvc_compiler_get_member_name(compiler, id, i));
+        if (addProgramUniform(program, memberName, root, baseOffset + offset, size, false) < 0)
+            return false;
+        if (!addUniformMembers(compiler, program, memberType, memberName, root, baseOffset + offset))
+            return false;
+        offset += size;
+    }
+    return true;
+}
